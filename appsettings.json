{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "Host": "0.0.0.0",
    "Port": 5000,
    "PublicUrl": ""
  },
  "Auth": {
    "JwtSecret": ""
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Licensing": {
    "BaseUrl": "",
    "LicenseKey": "",
    "DeviceName": "",
    "NebulaVersion": "1.0.0",
    "HeartbeatMinutes": 30,
    "RequestTimeoutSeconds": 15,
    "RequireSignature": true,
    "PublicKeyPem": "",
    "AllowInvalidCertificate": false,
    "MachineHashOverride": ""
  },
  "Performance": {
    "MaxConcurrentDownloads": 4,
    "ConcurrentFragmentDownloads": 16,
    "HttpChunkSizeBytes": 10485760
  },
  "Storage": {
    "KeepDownloads": true
  }
}
