{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "Host": "0.0.0.0",
    "Port": 5000,
    "PublicUrl": ""
  },
  "Auth": {
    "JwtSecret": ""
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Performance": {
    "MaxConcurrentDownloads": 4,
    "ConcurrentFragmentDownloads": 16,
    "HttpChunkSizeBytes": 10485760
  },
  "Storage": {
    "KeepDownloads": true
  }
}
