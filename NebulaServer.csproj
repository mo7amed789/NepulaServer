<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DefaultItemExcludes>$(DefaultItemExcludes);Temp\**;NebulaMobileAndroid\**;Python\**;Tools\QueueChecks\**;Tools\LifecycleChecks\**;Tools\ImageChecks\**;Tools\DesktopChecks\**</DefaultItemExcludes>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>

  </PropertyGroup>

  <!-- Release -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">

    <SelfContained>true</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

   </PropertyGroup>

  <!-- ========================= -->
  <!-- Ignore Python Runtime     -->
  <!-- ========================= -->

  <ItemGroup>

    <!-- Don't compile anything under Python -->
    <Compile Remove="Python\**" />
    <EmbeddedResource Remove="Python\**" />
    <Content Remove="Python\**" />
    <None Remove="Python\**" />

    <!-- Don't compile licensing server nested inside this project -->
    <Compile Remove="NebulaLicensingServer\**" />
    <EmbeddedResource Remove="NebulaLicensingServer\**" />
    <Content Remove="NebulaLicensingServer\**" />
    <None Remove="NebulaLicensingServer\**" />

    <!-- Keep local verification/publish output from being compiled as source. -->
    <Compile Remove="Temp\**" />
    <EmbeddedResource Remove="Temp\**" />
    <Content Remove="Temp\**" />
    <None Remove="Temp\**" />

  </ItemGroup>

  <!-- ========================= -->
  <!-- Publish Python Runtime    -->
  <!-- ========================= -->

  <ItemGroup>

    <!-- Python اتشال فوق بـ Remove فالـ Include هنا صحيح ومفيش تكرار -->
    <None Include="Python\**\*" Exclude="Python\**\__pycache__\**;Python\**\*.pyc;Python\**\*.pyo;Python\**\tests\**;Python\**\test\**;Python\Lib\site-packages\bin\**;Python\Lib\site-packages\share\**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <None Update="Python\nebula_engine.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>


    <!-- FIX: Update بدل Include — الملفات دي داخلة أصلاً في الـ Default None Glob
         و Include كان بيعمل Duplicate Items وبيسبب خطأ NETSDK1152 عند الـ Publish -->
    <None Update="Engine\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>

    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>

    <None Update="Tools\VC_redist.x64.exe">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>

  </ItemGroup>

  <!-- ========================= -->
  <!-- Files                     -->
  <!-- ========================= -->

  <ItemGroup>

    <None Update="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>

    <None Update="ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>

    <None Update="ffprobe.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>

    <!-- FIX: في Web SDK ملفات الـ json بتتسجل كـ Content مش None -->
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <Content Include="Html\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <!-- FIX: القيم كانت على سطور متعددة بمسافات زائدة — MSBuild كان هيرفضها
         "PreserveNewest" لازم تكون قيمة نظيفة بدون Whitespace -->
    <Content Update="appsettings.Development.json" Condition="'$(Configuration)'=='Release'">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>

  </ItemGroup>

  <!-- Never ship signing keys or per-installation runtime identity. -->
  <ItemGroup>
    <Content Remove="Keys\private.pem;private_key.pem;device_id.txt" />
    <None Remove="Keys\private.pem;private_key.pem;device_id.txt" />

    <!-- The application only needs the public verification key at runtime. -->
    <None Update="Keys\public.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Also remove stale sensitive files when publishing into a reused directory. -->
  <Target Name="RemoveSensitivePublishFiles" AfterTargets="Publish">
    <ItemGroup>
      <_SensitivePublishFiles Include="$(PublishDir)Keys\private.pem;$(PublishDir)private_key.pem;$(PublishDir)device_id.txt" />
    </ItemGroup>
    <Delete Files="@(_SensitivePublishFiles)" />
  </Target>

  <!-- ========================= -->
  <!-- Packages                  -->
  <!-- ========================= -->

  <ItemGroup>

    <PackageReference Include="AngleSharp" Version="1.7.1" />

    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />

    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />

    <!-- FIX: كانت نسخة Preview قديمة (10.0.0-preview.4) — اتحولت للنسخة المستقرة -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Photino.NET" Version="3.1.18" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />

    <PackageReference Include="QRCoder" Version="1.8.0" />

    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />

    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.3" />

    <!-- FIX: كانت 9.0.0 — اتوحدت مع net10.0 -->
    <PackageReference Include="System.Management" Version="10.0.0" />

  </ItemGroup>



</Project>


